# EditorConfig — https://editorconfig.org
# Line endings must agree with .gitattributes (LF everywhere, CRLF for Windows scripts).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,py}]
indent_size = 4

[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
