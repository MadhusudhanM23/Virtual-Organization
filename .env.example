# =============================================================================
# Virtual Organization: local development environment
#
# DEV-ONLY PLACEHOLDERS. Every value below is a non-secret placeholder for a
# local developer machine. Never reuse them anywhere else, and never commit a
# filled-in copy (NFR-14). `.env` is gitignored; only this example is tracked.
#
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# Consumed by: docker compose (--env-file .env) and the API (Plan 1.2+).
# =============================================================================

# --- PostgreSQL 16 + PostGIS (infra/docker/compose.yaml, service "postgres") ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=virtual_org
# Owner role: runs Flyway migrations and owns the tables (ADR-28).
# Superuser only inside the local dev container.
POSTGRES_USER=vo_owner
POSTGRES_PASSWORD=change-me-owner

# --- Runtime database roles (created by Flyway migrations, ADR-28) ---
# vo_app: application role, subject to forced row-level security.
VO_APP_DB_PASSWORD=change-me-app
# vo_outbox: outbox publisher only (BYPASSRLS, evt schema grants only).
VO_OUTBOX_DB_PASSWORD=change-me-outbox
# vo_sim: simulation runs, writes the sim schema only.
VO_SIM_DB_PASSWORD=change-me-sim

# --- Redis 7 (service "redis") ---
REDIS_URL=redis://localhost:6379

# --- Built-in dev JWT issuer (ADR-16) ---
# Key file is generated locally; secrets/ and *.pem are gitignored.
VO_JWT_KEY_PATH=./secrets/dev-jwt.pem

# --- Seeded demo users (local/demo profiles only) ---
DEMO_USER_PASSWORD=change-me-demo

# --- Vision (Phase 7, ADR-69) ---
# Shared secret of the demo tenant's vision service credential (svc-vision-local); at least 24 characters.
# Set the same value for the API and for `python -m vorg_vision run`. Empty disables vision ingestion.
VO_VISION_INGEST_SECRET=
# Directory of the downloaded camera media (scripts/fetch-vision-assets.ps1); default ../vision/assets from services/api.
# VO_VISION_MEDIA_DIR=

# --- AI Operations Assistant (Phase 9, ADR-17) ---
# Set it only in your local .env (gitignored). Never commit a real key.
OPENAI_API_KEY=
# Gateway services/ai (port 8090, ADR-64/65). The OpenAI provider is used only when the key is set AND
# VO_AI_PROVIDER=auto AND the tenant has llm_external_allowed=true; otherwise the offline provider answers.
VO_AI_PROVIDER=auto
VO_AI_OPENAI_MODEL=gpt-4o-mini
VO_AI_PROVIDER_REGION=unspecified
# redacted: store redacted question/answer text with each exchange; none: hashes and metadata only.
VO_AI_RETENTION=redacted
VO_API_BASE_URL=http://localhost:8080
