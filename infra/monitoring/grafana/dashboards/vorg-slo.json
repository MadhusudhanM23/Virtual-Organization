    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox backlog",
      "description": "Pending count, age of the oldest pending event and events that exhausted their retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "vorg-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
