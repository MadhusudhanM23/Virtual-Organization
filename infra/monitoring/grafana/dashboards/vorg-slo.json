        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vorg-prometheus"
          },
          "expr": "max(vo_outbox_pending)",
          "legendFormat": "pending events"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vorg-prometheus"
          },
          "expr": "max(vo_outbox_oldest_age_seconds)",
          "legendFormat": "oldest pending age (s)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vorg-prometheus"
          },
          "expr": "increase(vo_outbox_dead_total[10m])",
          "legendFormat": "DEAD in 10 min"
        }
      ]
    },
