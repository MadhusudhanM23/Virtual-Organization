      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vorg-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"vorg-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"vorg-api\"}[5m])), 0.001)",
          "legendFormat": "5xx share"
        }
      ]
