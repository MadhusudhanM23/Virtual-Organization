<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.vorg</groupId>
  <artifactId>virtual-organization</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Virtual Organization</name>
  <description>Root aggregator for the Virtual Organization digital-twin platform (ADR-15).</description>

  <modules>
    <module>services/simulation</module>
    <module>services/optimization</module>
    <module>services/api</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <archunit.version>1.5.1</archunit.version>
    <uuid-creator.version>6.1.1</uuid-creator.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <!-- Security overrides of the Spring Boot 4.1.1 managed versions (Plan 11.5, Trivy on the Maven SBOM): embedded Tomcat
         11.0.24 has 3 CRITICAL CVEs fixed in 11.0.25; Jackson 3.1.5 has 5 HIGH CVEs fixed in 3.1.7. Remove an override
         once the Spring Boot parent manages a version at or above it. -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.f4b6a3</groupId>
        <artifactId>uuid-creator</artifactId>
        <version>${uuid-creator.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <!-- SBOM (Plan 11.5): `mvnw org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom`, see scripts/supply-chain.ps1. -->
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.1</version>
          <configuration>
            <projectType>application</projectType>
            <schemaVersion>1.6</schemaVersion>
            <outputFormat>json</outputFormat>
            <outputName>bom</outputName>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
