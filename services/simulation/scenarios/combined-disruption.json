{
  "schema": "vorg.simulation.scenario.v1",
  "scenario_id": "combined-disruption",
  "name": "Dock closure, forklift outage, fewer pickers and a demand peak",
  "description": "Exercises every overlay type: IN-02 closed 60-240 min, FL-10 out of service 120-300 min, two pickers absent 0-240 min, order arrivals x1.25 from 180 to 360 min, slower unloading.",
  "baseline": "bengaluru-warehouse-01",
  "run": {
    "master_seed": 20261012,
    "replications": 10,
    "horizon_min": 480,
    "warmup_min": 30
  },
  "overlay": {
    "dock_closures": [
      { "dock_id": "IN-02", "start_min": 60, "end_min": 240, "reason": "leveller repair" }
    ],
    "forklift_outages": [
      { "forklift_id": "FL-10", "start_min": 120, "end_min": 300, "reason": "battery fault" }
    ],
    "worker_reductions": [
      { "role": "PICKING", "count": 2, "start_min": 0, "end_min": 240, "reason": "absence" }
    ],
    "demand_multiplier": { "factor": 1.25, "start_min": 180, "end_min": 360 },
    "parameter_overrides": {
      "unload_time_per_pallet_min": { "dist": "triangular", "min": 1.4, "mode": 1.9, "max": 3.0 }
    }
  }
}
