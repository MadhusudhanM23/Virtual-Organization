{
  "name": "@vo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Virtual Organization web client — React + TypeScript + Vite + Tailwind CSS.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "e2e:incidents": "playwright test -c playwright.incidents.config.ts",
    "e2e:replay": "playwright test -c playwright.replay.config.ts",
    "e2e:scenarios": "playwright test -c playwright.scenarios.config.ts",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "e2e:mcd": "playwright test -c playwright.mcd.config.ts",
    "e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "e2e:chaos": "playwright test -c playwright.chaos.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@vo/twin-schema": "*",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
