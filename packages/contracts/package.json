{
  "name": "@vo/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Language-neutral JSON Schema contracts (event envelope, problem, command ack) with generated TypeScript types and an Ajv validator.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
